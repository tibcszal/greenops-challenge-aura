# Paste this run's block from the challenge dashboard, then:
#   cp greenops.env.example greenops.env && $EDITOR greenops.env
#   source scripts/greenops-env.sh
# greenops*.env is gitignored; never commit the filled-in copy.

export EXOSCALE_API_KEY='...'
export EXOSCALE_API_SECRET='...'
export GREENOPS_CLOUD_ENDPOINT='https://.../runs/<id>/cloud/v2'
export GREENOPS_GRID_ENDPOINT='https://.../runs/<id>/grid/v4'
export GREENOPS_GRID_SECRET='...'
